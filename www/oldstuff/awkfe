#include <sys/types.h>
#include <sys/stat.h>
#include <stdio.h>
#include <fcntl.h>
#include <malloc.h>
#include <string.h>
#include <unistd.h>
#include <errno.h>
#ifndef DEF_AWK
#   define  DEF_AWK         "/usr/bin/awk"
#endif
#define  INC_STR         "#include "
#define  START_GLOBAL    '<'
#define  END_GLOBAL      '>'
#define  LOCAL_IND       '"'

int ap;
char *progname;
char **ap_arr;

void help(msg)
   char *msg;
   
   {
   fprintf (stderr,
      "%s: add include files to awk standalone scripts\n"
      "%s%s"
      "Format: #!/full/path/name/of/%s\n"
      "        the full path name should not exceed 30 chars\n",
         progname,
         (msg) ? msg : "",
         (msg) ? "\n\n" : "",
         progname
         );
   exit((msg) ? 1 : 0);
   }

static char *getInc(inc)
   char   *inc;
   
   {
   char *loc;
   char *p,*q;
   int i;
   int fd;
   char buf[512];

   if (NULL == (q = strpbrk(inc, "<\"")))
      {
      fprintf(stderr,"Unrecognized path format\n");
      return NULL;
      }
   
   if (NULL == (loc = strdup(q)))
      {
      fprintf(stderr,"getInc: Can't dup include line\n");
      return NULL;
      }

   switch (*loc)
      {
      case START_GLOBAL   :
         if (NULL == (p = strchr(loc+1,END_GLOBAL)))
            {
            fprintf(stderr,"Misformed path - missing trailing '%c'\n"
                           "in loc: '%s'\n",
               END_GLOBAL,loc);
            return NULL;
            }
         else
            *p = '\0';
         /* ok,  now the fun part - searching the awkpath for a match */
         for (i=0;i<ap && ap_arr[i];i++)
            {
            sprintf(buf,"%s/%s", ap_arr[i],loc+1);
            if (EOF < (fd = open(buf,O_RDONLY)))
               {
               close(fd);
               return strdup(buf);
               }
            }
         return NULL;
         break;
      case LOCAL_IND   :
         /* just clean up and return path - awk will verify */
         if (NULL == (p = strchr(loc+1,LOCAL_IND)))
            {
            fprintf(stderr,"Misformed path - missing trailing '%c'\n",
               LOCAL_IND);
            return NULL;
            }
         else
            *p = '\0';
         break;
      default    :
         fprintf(stderr,"Unrecognized path format\n");
         return NULL;
         break;
      }
   
   return loc+1;
   }
    

char *read2buf(fn, sizep,errors)
   char   *fn;
   off_t  *sizep;
   char   **errors;

   {
   int         fd;
   char        *buf;
   struct stat statBuf;

   if (stat (fn, &statBuf))
      {
      *errors = "read2buf error on stat of file";
      return NULL;
      }

   if (sizep) *sizep = statBuf.st_size;

   /*
   * the allocated buffer must be one character greater than input file
   * this insures last byte will be NUL
   */
   if (NULL == (buf = (unsigned char *) malloc (statBuf.st_size + 1)))
      {
      *errors = "read2buf error mallocing input buf";
      return NULL;
      }

   if (EOF == (fd = open (fn, O_RDONLY)))
      {
      *errors = "Error on opening file";
      return NULL;
      }

   if (statBuf.st_size != read (fd, buf, statBuf.st_size))
      {
      *errors = "Error on reading file";
      return NULL;
      }

   buf[statBuf.st_size] = '\0';        /* terminate buffer */

   close (fd);

   return buf;
   }

main (argc,argv)

   int    argc;
   char **argv;

{
extern char *optarg;
extern int optind;
extern int optopt;
extern int errno;
extern int errno;
extern char *sys_errlist[];
char errmsg[256];
char *rderr;
int opt;
int i;
int linecnt;
int ac;
char *p,*q,*r,*s;
char *filepath;
char *filewa1;
off_t fsize;
char *contents;
char *awkpath;
char *awkwa1;
char *home;
char *awk;
char *al[256];

progname = (NULL == (p = strrchr(argv[0],'/'))) ? argv[0] : p + 1;

while ((opt = getopt(argc, argv, ":h")) != EOF)
   {
   switch (opt)
      {
      case 'h'    :
         help(NULL);
         break;
      case ':'   :
         sprintf(errmsg,"%s: Option -%c requires an argument\n",
                 progname, optopt);
         help(errmsg);
      case '?'   :
         sprintf(errmsg,"%s: Unrecognized option: -%c\n",
                 progname, optopt);
         help(errmsg);
      }
   }

if (0 == argc - optind)
   help("Missing file name");
   
filepath = argv[optind];

/*
 * read in the AWKPATH
 */
if (NULL == (awkpath = getenv("AWKPATH")))
   {
   if (NULL == (awkpath = (char *) calloc(1,512)))
      {
      perror ("Can't allocate default AWKPATH");
      exit(2);
      }
   /*
    * read in the HOME dir
    */
   home = getenv("HOME");
   /*
    * read in the path of the executable
    */
   if (NULL == (filewa1 = strdup(filepath)))
      {
      perror ("Can't allocate filepath copy");
      exit(2);
      }
   if (s = strrchr(filewa1,'/'))
      {
      *s = '\0';
      sprintf(awkpath,"%s:%s:%s",filewa1,".",(home) ? home : ".");
      }
   else   
      sprintf(awkpath,"%s:%s:%s",".",(home) ? home : ".");
   }

if (NULL == (awkwa1 = strdup(awkpath)))
   {
   perror ("Can't allocate copy of AWKPATH");
   exit(2);
   }

/*
 * Now use strtok to parse the AWKPATH
 */
for (ap=0,p=awkwa1;*p;p++)
   if (':' == *p)
      ap++;
ap++;

if (NULL == (ap_arr = (char **) calloc(ap + 1,sizeof (char *))))
   {
   perror ("Can't allocate array for AWKPATH");
   exit(2);
   }

ap_arr[ap] = NULL;

for (p=q=awkwa1,i=0;p=strtok(q,":");i++,q=NULL)
   ap_arr[i] = p;

if (NULL == (contents = read2buf(filepath,&fsize,&rderr)))
   {
   sprintf(errmsg,"%s: %s", rderr, sys_errlist[errno]);
   help(errmsg);
   }

if (0 == fsize) 
   {
   sprintf(errmsg,"the input file has zero size");
   help(errmsg);
   }

/*
 * Now parse the file looking for #include lines
 */
awk = NULL;
for (ac=1,p=q=contents,linecnt=i=0;i<fsize;i++,q++)
   {
   if ('\n' == *q)
      {
      *q = '\0';
      if (*p && ('#' == *p))
         {
         if (1 == linecnt)
            {
            /* look for alternate awk path */
            if ('!' == *(p+1))
               {
               if (s = strchr(p,'/'))
                  {
                  if (r = strchr(s,' ')) *r = '\0';
                  awk = s;
                  }
               }
            awk = (awk) ? awk : DEF_AWK;
            }
         linecnt++;
         
         if (0 == strncmp(p,INC_STR,sizeof(INC_STR) - 1))
            {
            if (NULL == (s = getInc(p)))
               {
               fprintf(stderr,"Can't resolve include line:\n%s\n"
                              "AWKPATH=%s\n",p,awkpath);
               exit(2);
               }
            al[ac++] = "-f";
            al[ac++] = s;
            }
         p = q+1;
         }
      else         /* Blank or non-comment line terminates scan */
         break;
      }
   }

if (NULL == (s = strrchr(awk,'/')))
   awk = DEF_AWK;

al[0]    = filepath;
al[ac++] = "-f";
al[ac++] = filepath;

/* now add other command line options */
for (i=optind+1;i<argc;i++)
   al[ac++] = argv[i];
   
al[ac] = NULL;

#ifdef DEBUG
for(i=0;i<ac;i++)
   printf("%d: %s\n", i, al[i]);
#endif

execv(awk, al);

perror("Execv failed");

exit(2);
}

